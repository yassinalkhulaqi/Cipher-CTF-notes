{
  "name": "redscribe-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Modern local-first frontend for RedScribe",
  "scripts": {
    "build": "node scripts/build.mjs && npm run typecheck",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/test.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
